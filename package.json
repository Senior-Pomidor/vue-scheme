{
  "name": "@listim/vue_hall_scheme_view",
  "private": false,
  "version": "1.0.3",
  "type": "module",
  "author": "Afisha tickets",
  "description": "Vue app for rendering hall schema",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.rambler.ru/listim/hall-schema-view"
  },
  "publishConfig": {
    "registry": "https://art.rambler.ru/api/npm/listim-npm/"
  },
  "scripts": {
    "dev": "vite",
    "watch": "vite build --watch",
    "start": "vite",
    "build": "vite build",
    "build:deploy": "vite build; npm run deploy",
    "deploy": "git add -f dist && git commit -m 'deploy' && git push origin `git subtree split --prefix dist master`:gh-pages --force && git add -A && git commit -m 'commit changes before deploy'",
    "preview": "vite preview",
    "el:check": "eslint --ext .js,.vue --ignore-path .eslintignore src",
    "el:fix": "eslint --ext .js,.vue --ignore-path .eslintignore --fix src"
  },
  "dependencies": {
    "vue": "^3.3.4"
  },
  "peerDependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.2.3",
    "eslint": "^8.39.0",
    "less": "^4.1.3",
    "less-loader": "^11.1.0",
    "stylelint": "^15.10.2",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-less": "^1.0.8",
    "terser": "^5.24.0",
    "vite": "^4.4.5",
    "vite-plugin-eslint": "^1.8.0",
    "vite-plugin-stylelint": "^4.3.0",
    "yarn": "^1.22.19"
  },
  "files": ["dist"],
  "main": "./dist/vue_hall_scheme_view.cjs",
  "module": "./dist/vue_hall_scheme_view.js"
}
